# .github/workflows/test.yml is generated: each stage is an aspect that gives jobs to the `workflow` sink.
# Stages run one after another (`needs`), so a push never starts every job at once on GitHub's runners:
#   fmt -> engine -> docs -> fleet -> flake-check, and one eval job per system of templates/fleet/ci.json.
{ sven, lib, inputs, ... }:
let
  setup = [
    { uses = "actions/checkout@v4"; }
    { uses = "cachix/install-nix-action@v31"; "with".github_access_token = "\${{ secrets.GITHUB_TOKEN }}"; }
  ];
  job = { needs ? [ ], timeout ? 30, runs-on ? "ubuntu-latest", pre ? [ ], nix ? { }, steps }: {
    inherit runs-on;
    timeout-minutes = timeout;
    steps = pre ++ map (s: if s ? "with" then s // { "with" = s."with" // nix; } else s) setup ++ steps; # `nix`: extra install-nix inputs
  } // lib.optionalAttrs (needs != [ ]) { inherit needs; };
  run = name: dir: script: { inherit name; run = script; } // lib.optionalAttrs (dir != null) { working-directory = dir; };
  empty = what: expr: ''
    out=$(${expr})
    echo "${what} = $out"
    test "$out" = "[ ]"
  '';
  # the fleet's CI targets, grouped by system: one job per system, its targets one after another
  targets = lib.groupBy (t: t.system) (builtins.fromJSON (builtins.readFile (inputs.sven + "/templates/fleet/ci.json")));
  runner = { x86_64-linux = "ubuntu-latest"; aarch64-linux = "ubuntu-24.04-arm"; aarch64-darwin = "macos-latest"; };
  # a small YAML writer: block style, `|` for multi-line strings, JSON-quoted scalars
  yaml = ind: v:
    let pad = lib.fixedWidthString ind " " ""; in
    if lib.isAttrs v then lib.concatStrings (lib.mapAttrsToList (k: x: "${pad}${builtins.toJSON k}:" + item ind x) v)
    else lib.concatMapStrings (x: "${pad}-" + (if lib.isAttrs x then "\n" + yaml (ind + 2) x else item ind x)) v;
  item = ind: x:
    if lib.isAttrs x then (if x == { } then " {}\n" else "\n" + yaml (ind + 2) x)
    else if lib.isList x then "\n" + yaml (ind + 2) x
    else if lib.isString x && lib.hasInfix "\n" x then " |\n" + lib.concatMapStrings (l: lib.fixedWidthString (ind + 2) " " "" + l + "\n") (lib.splitString "\n" (lib.removeSuffix "\n" x))
    else " ${builtins.toJSON x}\n";
in
{
  sven.helpers.yaml = yaml 0; # issue forms and other workflows use it too

  sven.kinds.site.sinks.workflow = {
    reduce = sven.lib.reduce.merge;
    files = { workflow, ... }: {
      files.file."../.github/workflows/test.yml".text = ''
        # DO-NOT-EDIT. Generated by docs/modules/ci.nix (the docs fleet). Regenerate: cd docs && nix run .#write-files
        # Jobs: ${lib.concatStringsSep ", " (lib.attrNames workflow)}
      '' + yaml 0 {
        name = "test";
        on = { push = { }; pull_request = { }; workflow_dispatch = { }; };
        concurrency = { group = "\${{ github.workflow }}-\${{ github.ref }}"; cancel-in-progress = true; };
        permissions.contents = "read";
        env.FLEET = "path:\${{ github.workspace }}?dir=templates/fleet";
        jobs = workflow;
      };
    };
  };

  sven.aspects.ci-fmt = {
    at = sven.kinds.site;
    workflow.fmt = job { steps = [
      (run "every nix file is formatted (nixfmt)" null "git ls-files -z '*.nix' | xargs -0 nix run nixpkgs#nixfmt-rfc-style -- --check")
      (run "the generated workflows are valid (actionlint)" null "nix run nixpkgs#actionlint -- .github/workflows/*.yml")
    ]; };
  };
  sven.aspects.ci-engine = {
    at = sven.kinds.site;
    workflow.engine = job { needs = [ "fmt" ]; timeout = 20; steps = [
      (run "engine and library oracles" null (empty "failed" "nix-instantiate --eval --strict tests -A failed"))
      (run "cost oracles (memos)" null "bash tests/cost.sh")
    ]; };
  };
  sven.aspects.ci-docs = {
    at = sven.kinds.site;
    workflow.docs = job { needs = [ "engine" ]; timeout = 60; steps = [
      (run "docs examples" "docs" (empty "failed" "nix eval --impure --file tests.nix failed"))
      (run "docs flake check: pages and this workflow current, examples, e2e" null "nix flake check -L \"git+file://\${{ github.workspace }}?dir=docs\"")
      (run "site build" "docs" "nix shell nixpkgs#nodejs nixpkgs#pnpm -c sh -c 'pnpm install --frozen-lockfile && pnpm build'")
    ]; };
  };
  sven.aspects.ci-fleet = {
    at = sven.kinds.site;
    workflow = {
      fleet = job { needs = [ "docs" ]; timeout = 120; steps = [
        (run "fleet checks" "templates/fleet" (empty "failed" "nix eval --impure --file tests.nix failed"))
        (run "real evaluations (e2e)" "templates/fleet" (empty "e2e.failed" "nix eval --impure --file tests.nix e2e.failed"))
        (run "trimmed module lists cost oracle" "templates/fleet" "bash cost.sh")
        (run "MCP server and flake app" "templates/fleet" "bash mcp/test.sh")
      ]; };
      flake-check = job {
        needs = [ "fleet" ];
        timeout = 120;
        pre = [ (run "enable KVM (the VM test)" null ''
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
        '') ];
        nix.extra_nix_config = "system-features = nixos-test benchmark big-parallel kvm";
        steps = [ (run "nix flake check" null "nix flake check -L \"$FLEET\"") ];
      };
    } // lib.mapAttrs' (system: ts: lib.nameValuePair "eval-${system}" (job {
      needs = [ "fleet" ];
      runs-on = runner.${system};
      steps = map (t: (run "evaluate ${t.name}" null ''
        drv=$(nix eval --raw "$FLEET#$ATTR.drvPath")
        echo "$drv"
        case "$drv" in /nix/store/*.drv) ;; *) exit 1 ;; esac
      '') // { env.ATTR = t.attr; }) ts; # env: an attr path can hold quotes
    })) targets;
  };
}
