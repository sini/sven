# Issues carry code. The issue form asks for a sven module; .github/workflows/issue.yml evaluates every ```nix block
# of an issue as one fleet (docs/issue/eval.nix) and comments the answer: errors, scopes, active aspects, invariants.
# The evaluation is pure and restricted (--restrict-eval), with a timeout, and its step holds no token.
{
  sven,
  lib,
  inputs,
  ...
}:
let
  y = sven.helpers.yaml;
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
  dnd =
    what:
    "# DO-NOT-EDIT. Generated by docs/modules/issues.nix (${what}). Regenerate: cd docs && nix run .#write-files\n";
  form = {
    name = "Bug or question";
    description = "Something sven does, or does not do. A sven module that shows it is required.";
    body = [
      {
        type = "markdown";
        attributes.value = "Thanks for writing. CI evaluates every `nix` block of this issue as one sven fleet and comments the answer, so a small module that shows the problem gets a fast reply.";
      }
      {
        type = "textarea";
        id = "module";
        attributes = {
          label = "A sven module";
          description = "A file of `modules/`: `{ sven, lib, ... }: { … }`. Declare the kinds it needs. `lib` is nixpkgs lib.";
          render = "nix";
        };
        validations.required = true;
      }
      {
        type = "textarea";
        id = "more";
        attributes = {
          label = "Another module (optional)";
          render = "nix";
        };
      }
      {
        type = "textarea";
        id = "expected";
        attributes = {
          label = "What you expected";
        };
        validations.required = true;
      }
      {
        type = "textarea";
        id = "got";
        attributes = {
          label = "What you got";
          description = "An error, a value, or the answer of the CI comment.";
        };
        validations.required = true;
      }
    ];
  };
  workflow = {
    name = "issue";
    on.issues.types = [
      "opened"
      "edited"
    ];
    permissions = {
      contents = "read";
      issues = "write";
    };
    jobs.evaluate = {
      "if" = "contains(github.event.issue.body, '```nix')";
      runs-on = "ubuntu-latest";
      timeout-minutes = 10;
      steps = [
        {
          uses = "actions/checkout@v4";
          "with".persist-credentials = false;
        }
        { uses = "cachix/install-nix-action@v31"; }
        {
          name = "extract the nix blocks";
          env.BODY = "\${{ github.event.issue.body }}";
          run = ''
            printf '%s' "$BODY" > "$RUNNER_TEMP/body.md"
            bash docs/issue/extract.sh "$RUNNER_TEMP/body.md" "$RUNNER_TEMP/blocks"
          '';
        }
        {
          name = "evaluate them as one fleet (pure, restricted, no token)";
          run = ''
            np=$(nix flake prefetch --json "$(jq -r .nodes.nixpkgs.locked.url docs/flake.lock)" | jq -r .storePath)
            set +e
            timeout 120 nix-instantiate --eval --strict --json --restrict-eval \
              -I sven="$PWD" -I nixpkgs="$np" -I blocks="$RUNNER_TEMP/blocks" \
              --expr 'import ./docs/issue/eval.nix { sven = <sven>; nixpkgs = <nixpkgs>; blocks = <blocks>; }' \
              > "$RUNNER_TEMP/out.json" 2> "$RUNNER_TEMP/err.txt"
            rc=$?
            {
              echo "sven evaluated the \`nix\` blocks of this issue as one fleet ([docs/issue/eval.nix](https://github.com/vic/sven/blob/main/docs/issue/eval.nix), sven at $GITHUB_SHA)."
              echo
              if [ "$rc" = 0 ]; then echo '```json'; jq . "$RUNNER_TEMP/out.json"; else echo "Evaluation failed (exit $rc):"; echo; echo '```text'; grep -v '^warning' "$RUNNER_TEMP/err.txt" | tail -40; fi
              echo '```'
            } > "$RUNNER_TEMP/comment.md"
          '';
        }
        {
          name = "comment";
          env = {
            GH_TOKEN = "\${{ github.token }}";
            GH_REPO = "\${{ github.repository }}";
            NUMBER = "\${{ github.event.issue.number }}";
          };
          run = ''
            gh issue comment "$NUMBER" --edit-last --body-file "$RUNNER_TEMP/comment.md" || gh issue comment "$NUMBER" --body-file "$RUNNER_TEMP/comment.md"
          '';
        }
      ];
    };
  };
in
{
  sven.aspects.issues = {
    at = sven.kinds.site;
    files.files.file = {
      "../.github/ISSUE_TEMPLATE/bug.yml".text = dnd "the issue form" + y form;
      "../.github/ISSUE_TEMPLATE/config.yml".text =
        dnd "issue forms only"
        + y {
          blank_issues_enabled = false;
          contact_links = [
            {
              name = "Read the docs first";
              url = "https://github.com/vic/sven/tree/main/docs";
              about = "Every page is a tested example.";
            }
          ];
        };
      "../.github/workflows/issue.yml".text = dnd "the issue evaluator" + y workflow;
    };
    # extract.sh round trip: the sample issue of the contributing page, as GitHub sends it (CRLF), gives back its blocks
    out.checks.x86_64-linux.issue-extract =
      let
        sample = ../examples/contributing/issue;
        blocks = lib.filter (f: lib.hasPrefix "block-" f) (lib.attrNames (builtins.readDir sample));
        body = lib.replaceStrings [ "\n" ] [ "\r\n" ] (
          "Some text.\n\n"
          + lib.concatMapStrings (f: "```nix\n${builtins.readFile (sample + "/${f}")}```\n\ntext\n\n") blocks
          + "```sh\necho not nix\n```\n"
        );
      in
      pkgs.runCommand "issue-extract" { } ''
        printf '%s' ${lib.escapeShellArg body} > body.md
        bash ${../issue/extract.sh} body.md out
        diff -r out ${sample} -x '*.md' && touch $out
      '';
  };
}
