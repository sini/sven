# Repo files (README.md, ci.json) generated by github:sini/files. Each file gets a check: the committed file must match.
{ sven, lib, inputs, ... }:
let
  pkgs = inputs.nixpkgs.legacyPackages.x86_64-linux;
in
{
  sven.kinds.system.sinks.files = {
    at = s: s.name == "x86_64-linux"; # one writer for the repo
    out = { files, ... }:
      let
        e = lib.evalModules {
          modules = [
            inputs.files.module
            { _module.args.pkgs = pkgs; files.root = inputs.self; files.relativeRoot = "templates/fleet"; }
          ] ++ files;
        };
      in
      {
        packages.x86_64-linux.write-files = e.config.files.writer.drv;
        checks.x86_64-linux = e.config.files.checks;
      };
  };
  sven.aspects.files-input = { at = sven.fleet.main; flake-file.inputs.files.url = "github:sini/files"; };
}
